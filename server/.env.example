CLIENT_URL=http://localhost:5173
PORT=3000

# secret สำหรับตรวจ token login ต้องตรงกับ AUTH_SECRET ของ Auth Lambda
# สร้างได้ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ใส่เมื่อรันหลายเครื่อง (Auto Scaling) เช่น redis://xxx.cache.amazonaws.com:6379
# เว้นว่าง = เก็บ state ในหน่วยความจำ (เครื่องเดียว / dev)
REDIS_URL=
