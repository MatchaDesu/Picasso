# เว้นว่าง = ต่อ origin เดียวกับหน้าเว็บ (Vite proxy ตอน dev / nginx ตอน production)
# ใส่ URL เมื่อ server อยู่คนละโดเมน เช่น https://api.example.com
VITE_SOCKET_URL=

# URL ของ API Gateway ที่ต่อกับ Auth Lambda เช่น https://abc123.execute-api.ap-southeast-1.amazonaws.com
# เว้นว่าง = เรียก /auth ใน origin เดียวกัน (ตอน dev Vite proxy ไปที่ lambda/auth/local-server.js)
VITE_AUTH_API_URL=
